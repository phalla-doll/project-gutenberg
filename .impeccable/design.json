  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ordinary rendered button slot with the global typography/radius override.",
      "html": "<button class=\"ds-button-primary\">Read online</button>",
      "css": ".ds-button-primary{font-family:var(--font-sans,\"Satoshi\",sans-serif);display:inline-flex;align-items:center;justify-content:center;height:40px;padding:0 24px;border:1px solid transparent;border-radius:var(--radius,8px);background:var(--primary,#74436c);color:var(--primary-foreground,#fff);font-size:13px;line-height:16px;font-weight:600;letter-spacing:0;text-transform:none;cursor:pointer;transition:background 150ms ease,transform 150ms ease}.ds-button-primary:hover{background:rgb(116 67 108 / 0.8)}.ds-button-primary:focus-visible{outline:2px solid var(--ring,#905783);outline-offset:4px;}.ds-button-primary:active{transform:translateY(1px)}.ds-button-primary:disabled{opacity:.5;pointer-events:none}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Ordinary rendered button slot with the global typography/radius override.",
      "html": "<button class=\"ds-button-secondary\">Download</button>",
      "css": ".ds-button-secondary{font-family:var(--font-sans,\"Satoshi\",sans-serif);display:inline-flex;align-items:center;justify-content:center;height:40px;padding:0 24px;border:1px solid transparent;border-radius:var(--radius,8px);background:var(--secondary,#eadfed);color:var(--secondary-foreground,#54364f);font-size:13px;line-height:16px;font-weight:600;letter-spacing:0;text-transform:none;cursor:pointer;transition:background 150ms ease,transform 150ms ease}.ds-button-secondary:hover{background:rgb(234 223 237 / 0.8)}.ds-button-secondary:focus-visible{outline:2px solid var(--ring,#905783);outline-offset:4px;}.ds-button-secondary:active{transform:translateY(1px)}.ds-button-secondary:disabled{opacity:.5;pointer-events:none}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Ordinary rendered button slot with the global typography/radius override.",
      "html": "<button class=\"ds-button-outline\">More options</button>",
      "css": ".ds-button-outline{font-family:var(--font-sans,\"Satoshi\",sans-serif);display:inline-flex;align-items:center;justify-content:center;height:40px;padding:0 24px;border:1px solid var(--border,#ded0e2);border-radius:var(--radius,8px);background:transparent;color:var(--foreground,#352438);font-size:13px;line-height:16px;font-weight:600;letter-spacing:0;text-transform:none;cursor:pointer;transition:background 150ms ease,transform 150ms ease}.ds-button-outline:hover{background:var(--muted,#e9e0ec)}.ds-button-outline:focus-visible{outline:2px solid var(--ring,#905783);outline-offset:4px;}.ds-button-outline:active{transform:translateY(1px)}.ds-button-outline:disabled{opacity:.5;pointer-events:none}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Ordinary rendered button slot with the global typography/radius override.",
      "html": "<button class=\"ds-button-ghost\">More options</button>",
      "css": ".ds-button-ghost{font-family:var(--font-sans,\"Satoshi\",sans-serif);display:inline-flex;align-items:center;justify-content:center;height:40px;padding:0 24px;border:1px solid transparent;border-radius:var(--radius,8px);background:transparent;color:var(--foreground,#352438);font-size:13px;line-height:16px;font-weight:600;letter-spacing:0;text-transform:none;cursor:pointer;transition:background 150ms ease,transform 150ms ease}.ds-button-ghost:hover{background:var(--muted,#e9e0ec)}.ds-button-ghost:focus-visible{outline:2px solid var(--ring,#905783);outline-offset:4px;}.ds-button-ghost:active{transform:translateY(1px)}.ds-button-ghost:disabled{opacity:.5;pointer-events:none}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "text-input",
      "description": "Transparent bottom-boundary field; header search has a separate dark context.",
      "html": "<input class=\"ds-input\" type=\"search\" aria-label=\"Search books\" placeholder=\"Search books or authors\">",
      "css": ".ds-input{font-family:var(--font-sans,\"Satoshi\",sans-serif);height:40px;width:100%;min-width:0;padding:4px 0;border:1px solid transparent;border-bottom-color:var(--input,#cbb5d0);border-radius:var(--radius,8px);background:transparent;color:var(--foreground,#352438);font-size:16px;transition:border-color 150ms ease}.ds-input::placeholder{color:var(--muted-foreground,#6c5870)}.ds-input:hover{border-bottom-color:var(--ring,#905783)}.ds-input:focus-visible{border-bottom-color:var(--ring,#905783);outline:2px solid var(--ring,#905783);outline-offset:4px;}.ds-input:disabled{opacity:.5;cursor:not-allowed}@media(min-width:768px){.ds-input{font-size:14px}}"
    },
    {
      "name": "Current Navigation",
      "kind": "nav",
      "refersTo": "top-nav",
      "description": "Desktop current destination with the apricot bookmark underline and inset keyboard focus.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Preview navigation\"><a class=\"ds-nav-link\" href=\"#home\" aria-current=\"page\">Home</a><a class=\"ds-nav-link\" href=\"#browse\">Browse</a><a class=\"ds-nav-link\" href=\"#lists\">Reading Lists</a></nav>",
      "css": ".ds-nav{font-family:var(--font-sans,\"Satoshi\",sans-serif);display:flex;flex-wrap:wrap;background:var(--surface-dark,#352438);padding:0 8px}.ds-nav-link{position:relative;display:inline-flex;align-items:center;height:64px;padding:0 14px;color:var(--on-dark-soft,#e3d0df);font-size:14px;font-weight:500;text-decoration:none;transition:color 180ms ease}.ds-nav-link:hover,.ds-nav-link[aria-current=page]{color:var(--on-dark,#faf7fb)}.ds-nav-link[aria-current=page]::after{content:\"\";position:absolute;bottom:0;left:14px;right:14px;height:4px;border-radius:3px 3px 0 0;background:var(--bookmark,#f3c3a7)}.ds-nav-link:focus-visible{outline:2px solid var(--bookmark,#f3c3a7);outline-offset:-6px;border-radius:8px}"
    },
    {
      "name": "Discovery Topic",
      "kind": "chip",
      "refersTo": "topic-chip",
      "description": "White, softly lifted discovery topic shortcut with a plum border and text.",
      "html": "<a class=\"ds-topic\" href=\"#classics\">Classics</a>",
      "css": ".ds-topic{font-family:var(--font-sans,\"Satoshi\",sans-serif);display:inline-flex;align-items:center;justify-content:center;min-height:36px;padding:6px 14px;border-radius:999px;background:#ffffff;border:1px solid var(--border,#ded0e2);box-shadow:0 2px 3px rgb(53 36 56 / 0.04);color:var(--secondary-foreground,#54364f);font-size:13px;font-weight:500;text-decoration:none;transition:background 180ms ease}.ds-topic:hover{background:var(--secondary,#eadfed)}.ds-topic:focus-visible{outline:2px solid var(--ring,#905783);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-topic{transition:none}}"
    },
    {
      "name": "Dimensional Catalog Jacket",
      "kind": "card",
      "refersTo": "catalog-cover",
      "description": "The missing or failed cover variant shows shared jacket depth, paper edge, and visible aligned metadata. Shipping covers fill the same 2:3 face.",
      "html": "<a class=\"ds-book\" href=\"#book\" aria-label=\"Pride and Prejudice by Jane Austen\"><div class=\"ds-field\"><div class=\"ds-jacket\"><div class=\"ds-pages\"></div><div class=\"ds-face\"><div class=\"ds-fallback\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M12 5c-3-2-6-2-9-1v15c3-1 6-1 9 1 3-2 6-2 9-1V4c-3-1-6-1-9 1Zm0 0v15\"/></svg><span>Pride and Prejudice</span></div></div></div><span class=\"ds-open\">Open book</span></div><h2 class=\"ds-book-title\">Pride and Prejudice</h2><p class=\"ds-author\">Jane Austen</p></a>",
      "css": ".ds-book{font-family:var(--font-sans,\"Satoshi\",sans-serif);display:block;max-width:224px;border-radius:12px;color:var(--foreground,#352438);text-decoration:none}.ds-field{position:relative;display:flex;aspect-ratio:4/5;align-items:center;justify-content:center;overflow:hidden;border-radius:16px;background:var(--cover-field,#eee3f2);perspective:900px}.ds-jacket{position:relative;width:63%;aspect-ratio:2/3;transform-style:preserve-3d;transform:rotateY(-22deg) rotateZ(-3deg);transition:transform 320ms cubic-bezier(.22,1,.36,1)}.ds-face{position:absolute;inset:0;overflow:hidden;border-radius:2px 5px 5px 2px;background:#f7f1e8;box-shadow:9px 15px 18px -7px rgb(53 36 56 / .3);backface-visibility:hidden}.ds-face::after{content:\"\";position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,rgb(0 0 0 / .2),rgb(255 255 255 / .25) 3%,rgb(0 0 0 / .12) 5%,transparent 9%);box-shadow:inset 0 0 0 1px rgb(0 0 0 / .08)}.ds-pages{position:absolute;top:3px;bottom:3px;right:-7px;width:10px;border-radius:0 3px 3px 0;background:repeating-linear-gradient(90deg,#f4ecdc 0 2px,#cfc4b5 2px 3px);transform:skewY(8deg);box-shadow:2px 2px 1px rgb(53 36 56 / .18)}.ds-fallback{display:flex;height:100%;flex-direction:column;justify-content:space-between;gap:12px;padding:12px;box-sizing:border-box;background:var(--surface-dark,#352438);color:var(--on-dark,#faf7fb);font-family:var(--font-heading,\"Familjen Grotesk\",sans-serif);font-size:14px;line-height:1.25}.ds-fallback span{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden}.ds-book-title{min-height:44px;margin:16px 0 0;font-family:var(--font-heading,\"Familjen Grotesk\",sans-serif);font-size:16px;font-weight:500;line-height:1.375;letter-spacing:-.02em}.ds-author{margin:6px 0 0;color:var(--muted-foreground,#6c5870);font-size:14px;line-height:1.625}.ds-open{position:absolute;bottom:12px;padding:5px 10px;border-radius:999px;background:var(--foreground,#352438);color:var(--background,#faf7fb);font-size:11px;font-weight:500;opacity:0;transition:opacity 180ms ease}.ds-book:focus-visible{outline:2px solid var(--ring,#905783);outline-offset:6px}.ds-book:focus-visible .ds-open{opacity:1}@media(hover:hover){.ds-book:hover .ds-jacket{transform:translateY(-8px) rotateY(-8deg) rotateZ(0deg)}.ds-book:hover .ds-open{opacity:1}}@media(prefers-reduced-motion:reduce){.ds-jacket,.ds-open{transition:none}.ds-book:hover .ds-jacket{transform:rotateY(-22deg) rotateZ(-3deg)}}"
    },
    {
      "name": "Discovery Invitation",
      "kind": "custom",
      "refersTo": "discovery-opening",
      "description": "The opening\u2019s actual invitation typography and Browse action; the adjacent shipping display contains three real popular books.",
      "html": "<section class=\"ds-invitation\"><h1>Open a book.<em>Go somewhere new.</em></h1><p>Discover free classics, follow a little curiosity, and make room for your next great read.</p><a class=\"ds-feature\" href=\"#browse\">Find your next read <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg></a></section>",
      "css": ".ds-invitation{font-family:var(--font-sans,\"Satoshi\",sans-serif);padding:36px 40px;border-radius:24px;background:#482b43;color:var(--background,#faf7fb)}.ds-invitation h1{max-width:470px;margin:0;font-family:var(--font-heading,\"Familjen Grotesk\",sans-serif);font-size:52px;font-weight:500;line-height:1.05;letter-spacing:-.03em}.ds-invitation h1 em{display:block;margin-top:4px;color:var(--bookmark,#f3c3a7);font-family:var(--font-serif,\"EB Garamond\",Georgia,serif);font-size:1.12em;font-weight:400;letter-spacing:-.02em}.ds-invitation p{max-width:350px;margin:18px 0 0;color:var(--on-dark-soft,#e3d0df);font-size:15px;line-height:1.65}.ds-feature{display:inline-flex;align-items:center;gap:16px;min-height:44px;margin-top:24px;padding:11px 18px;box-sizing:border-box;border-radius:10px;background:var(--bookmark,#f3c3a7);color:var(--foreground,#352438);font-size:14px;font-weight:600;text-decoration:none;transition:background 180ms ease}.ds-feature:hover{background:#ffdbbf}.ds-feature:focus-visible{outline:2px solid var(--bookmark,#f3c3a7);outline-offset:4px}@media(max-width:1023px){.ds-invitation h1{font-size:42px}.ds-invitation h1 em{font-size:1em}}@media(max-width:767px){.ds-invitation{padding:28px 24px;border-radius:20px}.ds-invitation h1{font-size:36px}.ds-invitation h1 em{font-size:1.12em}.ds-invitation p{margin-top:12px;font-size:14px}.ds-feature{margin-top:16px}}"
    }
  ],
  "narrative": {
    "northStar": "The Artist\u2019s Book Exhibition",
    "overview": "An artist-residency exhibition translated into an approachable reading room. A deep plum shell and invitation, lilac-white ground, and apricot accents frame real books as dimensional objects. Page edges, hinge shading, directional soft shadows, and restrained perspective make discovery tactile without changing familiar catalog controls.\n\nThe home opening presents three linked popular books against layered lilac and peach planes. Catalog cards reuse the same jacket treatment, with visible title and author below. The reader stays quiet and adjustable; the book covers themselves supply the imagery, with no generated artwork or decorative grain.",
    "keyCharacteristics": [
      "Deep plum orientation and invitation surfaces on a lilac-white ground.",
